{
  "name": "base91-jdp-tools",
  "version": "0.4.0",
  "private": true,
  "description": "Corpus and website tooling for base91-jdp. The format itself is specified in spec/ and implemented in rust/; this manifest publishes nothing.",
  "type": "module",
  "scripts": {
    "corpus": "python3 bench/corpus.py",
    "corpus:core": "python3 bench/corpus.py --core",
    "corpus:short": "python3 bench/corpus.py --short",
    "site": "python3 site/build.py --serve",
    "site:check": "python3 site/build.py && python3 site/check_links.py"
  },
  "author": "Keywan Ghadami",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keywan-ghadami/base91-jdp.git"
  },
  "engines": {
    "node": ">=18.11"
  }
}
